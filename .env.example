# Copy to .env and change the secrets before sharing a deployment.
#   cp .env.example .env

PORT=4317
NODE_ENV=development

# Local npm start. docker compose overrides the hosts to the service names.
DATABASE_URL=postgres://penny:penny@127.0.0.1:5432/penny
REDIS_URL=redis://127.0.0.1:6379
DB_SCHEMA=public
# Set to 1 when connecting over an external URL that requires TLS.
DATABASE_SSL=0

# Required. 16+ random characters. Rotating it logs everyone out.
SESSION_SECRET=replace-with-a-long-random-string

# Demo mode seeds sample accounts, free credits, and labeled sample reviews.
# Set to 0 before any real launch. Sample content is never rendered when this is 0.
DEMO_MODE=1
SEED=1

# Leave at 0 until counsel and a processor that allows bidding-fee auctions approve you.
# Stripe is not supported. The only provider in this build is "mock".
PAYMENTS_ENABLED=0
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-with-another-long-random-string

SITE_URL=http://127.0.0.1:4317
COMPANY_NAME=PennyBid Demo Co.
SUPPORT_EMAIL=support@pennybid.example
JURISDICTION=Delaware, USA

# Required to seed an admin when DEMO_MODE=0. Ignored while demo mode is on
# (demo admin is admin@demo.test / admin123).
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=

UPLOAD_DIR=storage/uploads

# Product files. local (default) writes under UPLOAD_DIR. Set STORAGE_DRIVER=s3 for S3-compatible storage.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=0
TRUST_PROXY=0
COOKIE_SECURE=0
LOG_LEVEL=info

# Optional. When unset, messages are stored in the admin outbox only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PennyBid <no-reply@your-domain.example>
